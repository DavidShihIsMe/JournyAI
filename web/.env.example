OPENAI_API_KEY=fake-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional: after the AI draft, verify the itinerary with Google before returning:
# - Routes API: walk/transit/drive minutes (badge: "Google · walk time" / "Google · travel time")
# - Places API (New): hotel names on the plan form, hours, open/closed, ratings
# You must enable BOTH on the same Google Cloud project/key:
#   https://console.cloud.google.com/apis/library/routes.googleapis.com
#   https://console.cloud.google.com/apis/library/places.googleapis.com
# Server-side only — do not use NEXT_PUBLIC_*.
GOOGLE_MAPS_API_KEY=
